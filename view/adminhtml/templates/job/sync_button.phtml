<?php
declare(strict_types=1);

/** @var \Upcron\Monitor\Block\Adminhtml\Job\SyncButton $block */
?>
<div style="margin-bottom: 12px;">
    <button type="button"
            id="upcron_sync_btn"
            class="action-default scalable primary"
            onclick="upcronSync()">
        <?= $block->escapeHtml(__('Sync to Upcron')) ?>
    </button>
    <span id="upcron_sync_result" style="display:none; margin-left: 12px; padding: 6px 10px; border-radius: 3px;"></span>
</div>

<script>
function upcronSync() {
    var btn = document.getElementById('upcron_sync_btn');
    var resultEl = document.getElementById('upcron_sync_result');

    btn.disabled = true;
    resultEl.style.display = 'inline-block';
    resultEl.style.background = '#f8f8f8';
    resultEl.style.color = '#333';
    resultEl.style.border = '1px solid #ccc';
    resultEl.textContent = '<?= $block->escapeJs(__('Syncing...')) ?>';

    var params = new URLSearchParams();
    params.append('form_key', window.FORM_KEY);

    fetch('<?= $block->escapeJs($block->getSyncUrl()) ?>', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: params.toString()
    })
    .then(function(response) { return response.json(); })
    .then(function(data) {
        if (data.success) {
            resultEl.style.background = '#e6f4ea';
            resultEl.style.color = '#1a7f37';
            resultEl.style.border = '1px solid #1a7f37';
            resultEl.textContent = data.synced + ' <?= $block->escapeJs(__('heartbeats synced successfully')) ?>';
        } else {
            resultEl.style.background = '#fce8e6';
            resultEl.style.color = '#c0392b';
            resultEl.style.border = '1px solid #c0392b';
            resultEl.textContent = data.message || '<?= $block->escapeJs(__('Sync failed')) ?>';
        }

        if (data.success || data.partial) {
            reloadUpcronJobListing();
        }
    })
    .catch(function(err) {
        resultEl.style.background = '#fce8e6';
        resultEl.style.color = '#c0392b';
        resultEl.style.border = '1px solid #c0392b';
        resultEl.textContent = '<?= $block->escapeJs(__('Request failed')) ?>: ' + err;
    })
    .finally(function() {
        btn.disabled = false;
    });
}

function reloadUpcronJobListing() {
    if (!window.uiRegistry) {
        return;
    }

    var provider = window.uiRegistry('upcron_monitor_job_listing.upcron_monitor_job_listing_data_source');
    if (provider && typeof provider.reload === 'function') {
        provider.reload({ refresh: true });
    }
}
</script>
