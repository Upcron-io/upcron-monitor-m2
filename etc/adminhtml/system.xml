<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="upcron" translate="label" sortOrder="200">
            <label>Upcron Monitor</label>
        </tab>
        <section id="upcron_monitor" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>Upcron Monitor</label>
            <tab>upcron</tab>
            <resource>Upcron_Monitor::config</resource>
            <group id="api" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>API Configuration</label>
                <field id="base_url" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>API Base URL</label>
                    <comment>Must use HTTPS (e.g. https://app.upcron.com)</comment>
                    <backend_model>Upcron\Monitor\Model\Config\Backend\HttpsUrl</backend_model>
                    <validate>required-entry</validate>
                </field>
                <field id="bearer_token" translate="label comment" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Bearer Token</label>
                    <comment>API token. Stored encrypted.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <validate>required-entry</validate>
                </field>
                <field id="project_id" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Project ID</label>
                    <comment>Upcron project UUID</comment>
                    <validate>required-entry</validate>
                </field>
                <field id="connect_timeout" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Connect Timeout (seconds)</label>
                    <comment>HTTP connect timeout. Default: 3s. Minimum: 1s.</comment>
                    <validate>required-entry validate-greater-than-zero validate-digits</validate>
                </field>
                <field id="transfer_timeout" translate="label comment" type="text" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Transfer Timeout (seconds)</label>
                    <comment>HTTP transfer timeout. Default: 5s. Minimum: 1s.</comment>
                    <validate>required-entry validate-greater-than-zero validate-digits</validate>
                </field>
                <field id="test_connection" translate="label" type="button" sortOrder="60" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Test Connection</label>
                    <frontend_model>Upcron\Monitor\Block\Adminhtml\Config\TestConnectionButton</frontend_model>
                </field>
            </group>
        </section>
    </system>
</config>
